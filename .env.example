# Server-side Supabase connection. Keep all keys below out of frontend/.env files.
SUPABASE_URL=https://your-project.supabase.co
# Prefer the read-only anon key when RLS permits the required SELECT queries.
SUPABASE_ANON_KEY=
# Server-side only fallback; never expose this to the frontend or browser bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Legacy alias accepted by the backend if it is already used by the existing setup.
SUPABASE_KEY=

# Existing Storage bucket and single monitoring device
SUPABASE_BUCKET=monitoring-images
# SUPABASE_STORAGE_BUCKET=monitoring-images
DASHBOARD_DEVICE_ID=PI5-001
DASHBOARD_TRAP_NAME=Trap 001
DASHBOARD_TIMEZONE=Asia/Kolkata
OFFLINE_THRESHOLD_MINUTES=15

# Browser origins allowed to call the backend; use the exact HTTPS frontend origin in production.
CORS_ORIGINS=https://dashboard.example.com

# Public frontend build-time configuration. This is a URL only, never a Supabase secret.
VITE_API_BASE_URL=https://api.example.com

# Optional local Docker port mappings
BACKEND_PORT=8000
FRONTEND_PORT=8080
LOG_LEVEL=INFO
MAX_DETECTIONS=5000
